            content: '结合当前热点话题创作的内容，紧跟潮流增加曝光率...',
            imageUrl: `https://picsum.photos/400/400?random=${Math.floor(Math.random() * 100) + 100}`,
            scheduledTime: item.publishTime
          }))
        ]
      },
      {
        id: 'interactive',
        name: '互动玩法创作',
        description: '通过抽奖/免费送吸引用户助力推广',
        enabled: true,
        setEnabled: () => {},
        icon: <ShareAltOutlined />,
        color: '#eb2f96',
        content: [
          {
            id: 'interactive-1',
            title: '夏日新品福利社',
            content: '抽三位幸运粉丝送新品试用装，评论区留下你最想要的单品...',
            imageUrl: 'https://picsum.photos/400/400?random=401',
            scheduledTime: dayjs().add(2, 'day').format('YYYY-MM-DD HH:mm')
          },
          {
            id: 'interactive-2',
            title: '晒单赢好礼活动',
            content: '晒出你的使用心得，抽5名精选评论送限定周边礼盒...',
            imageUrl: 'https://picsum.photos/400/400?random=402',
            scheduledTime: dayjs().add(5, 'day').format('YYYY-MM-DD HH:mm')
          }
        ]
      },
      {
        id: 'assist',
