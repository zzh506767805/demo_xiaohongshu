                                                  key={index}
                                                  style={{
                                                    border: '1px solid #f0f0f0',
                                                    borderRadius: 8,
                                                    padding: 4,
                                                    cursor: 'pointer',
                                                    transition: 'all 0.3s'
                                                  }}
                                                  onClick={() => {
                                                    const imageUrl = `https://picsum.photos/400/400?random=${index}`;
                                                    if (!selectedImages.includes(imageUrl)) {
                                                      setSelectedImages([...selectedImages, imageUrl]);
                                                    }
                                                  }}
                                                >
                                                  <img
                                                    src={`https://picsum.photos/400/400?random=${index}`}
                                                    alt={`素材 ${index + 1}`}
                                                    style={{ 
                                                      width: '100%', 
                                                      height: 150, 
                                                      objectFit: 'cover',
                                                      borderRadius: 4
                                                    }}
                                                  />
                                                </div>
                                              ))}
                                            </div>
