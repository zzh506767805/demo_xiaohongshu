                                          type="text"
                                          icon={<DeleteOutlined />}
                                          style={{
                                            position: 'absolute',
                                            top: '4px',
                                            right: '4px',
                                            background: 'rgba(255,255,255,0.8)',
                                            padding: '4px',
                                            minWidth: 'unset',
                                            height: 'unset'
                                          }}
                                          onClick={() => {
                                            const newImages = [...selectedImages];
                                            newImages.splice(index, 1);
                                            setSelectedImages(newImages);
                                          }}
                                        />
                                      </div>
                                    ))}
                                    <Button 
                                      type="dashed"
                                      style={{ 
                                        height: '100%',
                                        aspectRatio: '1',
                                        display: 'flex',
                                        alignItems: 'center',
                                        justifyContent: 'center'
                                      }}
