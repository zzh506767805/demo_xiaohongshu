                        >
                          <Select.Option value="daily">每日改写 (每天1篇内容)</Select.Option>
                          <Select.Option value="weekly">每周改写 (每周3篇内容)</Select.Option>
                          <Select.Option value="biweekly">双周改写 (每两周5篇内容)</Select.Option>
                        </Select>
                        <div style={{ marginTop: '12px', color: '#666', fontSize: '13px' }}>
                          设置系统自动查找热门文章并改写的频率，频率越高，获取的素材越多
                        </div>
                      </Card>

                      <Card title="发布策略" style={{ marginTop: '16px' }}>
                        <div style={{ marginBottom: '16px' }}>
                          <div style={{ marginBottom: '8px', fontWeight: 'bold' }}>当有热文可改写时：</div>
                          <Radio.Group 
                            value={newProductStrategy.mode}
                            onChange={(e: RadioChangeEvent) => setNewProductStrategy({
