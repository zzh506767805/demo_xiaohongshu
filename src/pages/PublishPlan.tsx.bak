          overflow: 'auto',
          flexShrink: 0
        }}>
          <div style={{ 
            fontWeight: 'bold', 
            fontSize: '16px', 
            marginBottom: '16px',
            padding: '0 8px'
          }}>
            创作技能列表
          </div>
          
          {skillsList.map(skill => (
            <div 
              key={skill.id}
              onClick={() => setSelectedSkill(skill.id)}
              style={{ 
                padding: '12px 16px',
