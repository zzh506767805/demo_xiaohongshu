                                  {
                                    title: '商品名称',
                                    dataIndex: 'name',
                                    key: 'name',
                                  },
                                  {
                                    title: '分类',
                                    dataIndex: 'category',
                                    key: 'category',
                                  },
                                  {
                                    title: '价格',
                                    dataIndex: 'price',
                                    key: 'price',
                                  },
